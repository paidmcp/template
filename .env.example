# Receiver wallet (same address works on Base and Plasma).
# `npm run setup` fills this in. Back it up: it controls the received funds.
SEED_PHRASE=""

# test = Base Sepolia (testnet), live = Base mainnet + Plasma mainnet
NETWORK_MODE="test"

# Optional overrides. Empty values use the defaults for NETWORK_MODE:
# - test: Base Sepolia RPC, Base Sepolia USDC, https://x402.org/facilitator
# - live: Base mainnet RPC, Base mainnet USDC, Coinbase CDP facilitator
BASE_RPC_URL=""
USDC_ADDRESS=""
BASE_FACILITATOR_URL=""
# Set to "off" to stop accepting payments on Base.
BASE_PAYMENTS="on"

# Plasma (USDT0) is mainnet-only. Empty = enabled in live mode with the
# Semantic facilitator, disabled in test mode.
PLASMA_FACILITATOR_URL=""
PLASMA_RPC_URL="https://rpc.plasma.to"
USDT0_ADDRESS="0xB8CE59FC3717ada4C02eaDF9682A9e934F625ebb"

# Required when BASE_FACILITATOR_URL points to Coinbase CDP (live default)
CDP_API_KEY_ID=""
CDP_API_KEY_SECRET=""

# Free unpaid calls per client IP. Empty = 10 in test mode, 0 in live mode.
# IP-based limits can be bypassed by clients with many IPs; keep this low
# (or 0) for anything expensive in live mode.
FREE_TRIAL_CALLS=""

# Number of reverse proxies in front of the server. Set to 1 on Fly.io or
# Railway so client IPs are read correctly. Keep 0 if clients connect
# directly, otherwise X-Forwarded-For can be spoofed to reset trials.
TRUST_PROXY="0"

# Session limits (sessions idle longer than this are closed)
MAX_SESSIONS="1000"
SESSION_IDLE_MINUTES="30"

# Server
PORT="4021"

# Optional for AI-powered tools in forks
ANTHROPIC_API_KEY=""

# Optional DB override. On Fly set DB_PATH=/app/data/paidmcp.db (mounted volume).
DB_PATH="./paidmcp.db"
